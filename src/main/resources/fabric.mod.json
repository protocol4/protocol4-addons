{
	"schemaVersion": 1,
	"id": "protocol4-addons",
	"version": "${version}",
	"name": "protocol4 addons",
	"description": "Hypixel SkyBlock quality-of-life addons.",
	"authors": [
		"protocol4"
	],
	"license": "CC0-1.0",
	"icon": "assets/protocol4-addons/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.protocol4.Protocol4Addons",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "io.github.protocol4.Protocol4AddonsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"protocol4-addons.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}